<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Detalle de venta – ArgenGaming Admin</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: sans-serif; background: #131315; color: #fff; margin: 0; }
    header { background: #1e1e20; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #2a2a2c; }
    header h1 { color: #00dbe9; margin: 0; font-size: 1.3rem; }
    header nav a { color: #aaa; text-decoration: none; font-size: 0.9rem; margin-left: 1rem; }
    header nav a:hover { color: #fff; }
    main { padding: 2rem; max-width: 700px; }
    h2 { color: #00dbe9; margin-bottom: 0.5rem; }
    .info { color: #aaa; margin-bottom: 1.5rem; font-size: 0.95rem; }
    .info span { color: #fff; }
    table { width: 100%; border-collapse: collapse; background: #1e1e20; border-radius: 10px; overflow: hidden; }
    th { background: #2a2a2c; padding: 0.8rem 1rem; text-align: left; font-size: 0.85rem; color: #aaa; text-transform: uppercase; }
    td { padding: 0.8rem 1rem; border-bottom: 1px solid #2a2a2c; font-size: 0.95rem; }
    tr:last-child td { border-bottom: none; }
    .total-row { background: #2a2a2c; font-weight: bold; }
    .btn-volver { display: inline-block; margin-top: 1.5rem; padding: 0.6rem 1.2rem; background: transparent; border: 1px solid #444; border-radius: 6px; color: #aaa; text-decoration: none; font-size: 0.9rem; }
    .btn-volver:hover { color: #fff; border-color: #aaa; }
  </style>
</head>
<body>

  <header>
    <h1>ArgenGaming — Panel Admin</h1>
    <nav>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/ventas">Ventas</a>
      <a href="/admin/logout">Cerrar sesión</a>
    </nav>
  </header>

  <main>
    <h2>Venta #<%= venta.id %></h2>
    <div class="info">
      <p>Cliente: <span><%= venta.nombreCliente %></span></p>
      <p>Fecha: <span><%= new Date(venta.createdAt).toLocaleDateString("es-AR", { day:"2-digit", month:"2-digit", year:"numeric", hour:"2-digit", minute:"2-digit" }) %></span></p>
    </div>

    <table>
      <thead>
        <tr>
          <th>Producto</th>
          <th>Cantidad</th>
          <th>Precio unit.</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% detalles.forEach(d => { %>
        <tr>
          <td><%= d.nombreProducto %></td>
          <td><%= d.cantidad %></td>
          <td>$<%= d.precioUnitario.toLocaleString("es-AR") %></td>
          <td>$<%= d.subtotal.toLocaleString("es-AR") %></td>
        </tr>
        <% }) %>
        <tr class="total-row">
          <td colspan="3">Total</td>
          <td>$<%= venta.total.toLocaleString("es-AR") %></td>
        </tr>
      </tbody>
    </table>

    <a href="/admin/ventas" class="btn-volver">Volver a ventas</a>
  </main>

</body>
</html>
