<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Productos – ArgenGaming Admin</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: sans-serif; background: #131315; color: #fff; margin: 0; }
    header { background: #1e1e20; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #2a2a2c; }
    header h1 { color: #00dbe9; margin: 0; font-size: 1.3rem; }
    header nav a { color: #aaa; text-decoration: none; font-size: 0.9rem; margin-left: 1rem; }
    header nav a:hover { color: #fff; }
    main { padding: 2rem; }
    h2 { color: #00dbe9; margin-bottom: 1.5rem; }
    table { width: 100%; border-collapse: collapse; background: #1e1e20; border-radius: 10px; overflow: hidden; }
    th { background: #2a2a2c; padding: 0.8rem 1rem; text-align: left; font-size: 0.85rem; color: #aaa; text-transform: uppercase; }
    td { padding: 0.8rem 1rem; border-bottom: 1px solid #2a2a2c; font-size: 0.95rem; vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    img.thumb { width: 50px; height: 50px; object-fit: contain; background: #2a2a2c; border-radius: 6px; }
    .badge-activo   { background: #1a3a1a; color: #4caf50; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.8rem; }
    .badge-inactivo { background: #3a1a1a; color: #f44336; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.8rem; }
    .btn { padding: 0.4rem 0.9rem; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85rem; }
    .btn-editar   { background: #00dbe9; color: #131315; }
    .btn-activar  { background: #4caf50; color: #fff; }
    .btn-desactivar { background: #f44336; color: #fff; }
    .btn:hover { opacity: 0.85; }
  </style>
</head>
<body>

  <header>
    <h1>ArgenGaming — Panel Admin</h1>
    <nav>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/ventas">Ventas</a>
      <a href="/admin/logout">Cerrar sesión</a>
    </nav>
  </header>

  <main>
    <h2>Productos</h2>

    <table>
      <thead>
        <tr>
          <th>Imagen</th>
          <th>Nombre</th>
          <th>Categoría</th>
          <th>Precio</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% productos.forEach(p => { %>
        <tr>
          <td><img class="thumb" src="/uploads/<%= p.imagen.split('/').pop() %>" alt="<%= p.nombre %>" onerror="this.style.display='none'"></td>
          <td><%= p.nombre %></td>
          <td><%= p.categoria %></td>
          <td>$<%= p.precio.toLocaleString("es-AR") %></td>
          <td>
            <% if (p.activo) { %>
              <span class="badge-activo">Activo</span>
            <% } else { %>
              <span class="badge-inactivo">Inactivo</span>
            <% } %>
          </td>
          <td style="display:flex; gap:0.5rem;">
            <a href="/admin/productos/editar/<%= p.id %>" class="btn btn-editar">Editar</a>
            <form method="POST" action="/admin/productos/toggleActivo" style="margin:0">
              <input type="hidden" name="id" value="<%= p.id %>">
              <button type="submit" class="btn <%= p.activo ? 'btn-desactivar' : 'btn-activar' %>">
                <%= p.activo ? 'Desactivar' : 'Activar' %>
              </button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </main>

</body>
</html>
